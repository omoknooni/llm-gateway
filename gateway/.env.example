# ── Application ──
APP_ENV=development
LOG_LEVEL=INFO
LOG_FORMAT=console

# ── PostgreSQL ──
# 런타임 역할은 gateway_app 입니다. 정책을 읽어 집행만 하고 스키마를 정의하지 않습니다.
# 권한 범위는 backend/docs/08-shared-contracts.md C4 를 따릅니다.
DATABASE_URL=postgresql+asyncpg://gateway_app:gateway_app_change_me@localhost:5432/llm_gateway
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=10
DB_POOL_RECYCLE=3600

# ── Redis ──
REDIS_URL=redis://localhost:6379/0
REDIS_SOCKET_TIMEOUT=2.0
REDIS_CONNECT_TIMEOUT=1.0
REDIS_HEALTH_CHECK_INTERVAL=30.0

# ── 캐시 TTL (gateway 소유. docs/README 의 Redis 키 규약) ──
VK_AUTH_TTL_SECONDS=300
POLICY_CACHE_TTL_SECONDS=300
VK_MISS_TTL_SECONDS=30

# ── AWS ──
# 자격 증명은 기본 credential chain 에 위임합니다(운영 IRSA / 로컬 프로필).
# 장기 액세스 키를 여기에 두지 않습니다.
AWS_REGION=ap-northeast-2
BEDROCK_THREAD_POOL_SIZE=128

# ── 요청 한도와 타임아웃 (docs/01) ──
MAX_BODY_SIZE=20971520
STREAM_TIMEOUT=300
# 반드시 앞단 ALB idle timeout 보다 작아야 합니다.
STREAM_IDLE_TIMEOUT=240
STREAM_DISCONNECT_DRAIN_TIMEOUT=30
DEFAULT_MAX_OUTPUT_TOKENS=4096

# ── client 식별 (docs/03 의 "알려진 client 값") ──
REGISTERED_CLIENTS=claude-code,claude-desktop,codex,openai-sdk

# ── 기록 ──
LAST_USED_THROTTLE_SECONDS=60
AUTH_EVENT_WINDOW_SECONDS=60
USAGE_SPOOL_MAX=10000
