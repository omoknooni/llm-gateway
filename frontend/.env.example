# ── Admin API 연결 ──
# 서버 전용입니다. 브라우저는 backend 를 직접 호출하지 않으므로 NEXT_PUBLIC_ 을 쓰지 않습니다.
ADMIN_API_URL=http://localhost:8000

# ── 개발용 로그인 ──
# backend 의 DEV_LOGIN_ENABLED 와 **항상 같은 값**이어야 합니다.
# 프론트만 켜면 토큰을 굽고도 모든 API 가 401 을 냅니다.
DEV_LOGIN_ENABLED=true

# dev 토큰에 담을 사용자 UUID(auth.users.id). 비우면 backend 의 합성 주체로 들어갑니다.
# 실제 사용자 소유 리소스를 다루려면 여기에 실제 UUID 를 넣으세요.
DEV_LOGIN_USER_ID=

# 세션 쿠키에 Secure 를 강제합니다. 비우면 요청 scheme 으로 판단합니다.
# HTTP 로 접속하는 로컬에서 true 로 두면 브라우저가 쿠키를 버려 로그인 루프가 됩니다.
SESSION_COOKIE_SECURE=

# ── Next.js ──
NEXT_TELEMETRY_DISABLED=1
