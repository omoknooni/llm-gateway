# ── Application ──
APP_ENV=development
LOG_LEVEL=INFO
DEBUG=false

# ── PostgreSQL ──
# 런타임 역할(backend_app). 마이그레이션은 별도 역할로 backend/db 에서 실행합니다.
DATABASE_URL=postgresql+asyncpg://backend_app:backend_app_change_me@localhost:5432/llm_gateway

# ── Redis ──
REDIS_URL=redis://localhost:6379/0

# ── 관리자 인증 ──
# 로컬 개발 전용 토큰 경로. 운영에서는 반드시 false.
DEV_LOGIN_ENABLED=true

# OIDC (사내 SSO). 비어 있으면 OIDC 경로 비활성.
OIDC_ISSUER_URL=
OIDC_AUDIENCE=
OIDC_PROVIDER_NAME=oidc
OIDC_JWKS_CACHE_TTL_SECONDS=3600
OIDC_USER_ID_CLAIM=sub
OIDC_EMAIL_CLAIM=email
OIDC_NAME_CLAIM=name
OIDC_GROUPS_CLAIM=groups

# 역할 부트스트랩 (콤마 구분)
ADMIN_EMAILS=
ADMIN_GROUPS=

# ── Virtual Key ──
VIRTUAL_KEY_ENV=dev
VIRTUAL_KEY_MAX_TTL_DAYS=365
VIRTUAL_KEY_MAX_ROTATION_GRACE_HOURS=168
